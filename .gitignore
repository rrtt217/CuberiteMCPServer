# --- Runtime artifacts, regenerated by mcc.lua on every MCC launch ---
# mcc_output.log:  MCC child process stdout log
# mcc_temp.ini:    temporary MCC launcher config (randomized bot name)
# mcc_temp.backup.ini: backup copy of the temporary MCC config
mcc_output.log
mcc_temp.ini
mcc_temp.backup.ini

# --- Machine-specific plugin config ---
# config.ini contains absolute local paths (e.g. Path=/home/<user>/...); the
# plugin regenerates it with defaults on first run, so each install keeps its
# own. Portable defaults live in settings.ini and are committed.
config.ini

# --- Editor / IDE local files ---
*.code-workspace
